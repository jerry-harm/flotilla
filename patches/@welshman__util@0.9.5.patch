+++ b/dist/util/src/Pow.js
@@ -118,6 +118,11 @@ call(() => {
     if (typeof Worker === "undefined") {
         return;
     }
+    // The worker hashes with crypto.subtle, which only exists in secure contexts (https or
+    // localhost). Skip the benchmark over plain http rather than failing inside the worker.
+    if (typeof crypto === "undefined" || !crypto.subtle) {
+        return;
+    }
     const secret = makeSecret();
     const pubkey = getPubkey(secret);
     const event = own(makeEvent(1, {}), pubkey);
